      "height": "3.25rem",
      "padding-x": "{space.4}",
      "radius": "{radius.md}",
      "font-size": "{size.16}"
    },
    "card": {
      "padding": "{space.5}",
      "padding-lg": "{space.8}",
      "radius": "{radius.lg}"
    },
    "nav": {
      "height": "5.5rem",
      "bottom-height": "4rem"
    },
    "badge": {
      "radius": "{radius.pill}",
      "padding-x": "{space.3}",
      "padding-y": "{space.1}"
    }

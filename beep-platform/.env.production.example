# Production beep.click : copier vers `.env.production`, puis `make init ENV_FILE=.env.production`.
# Compléter les valeurs vides avant `make prod-check ENV_FILE=.env.production`.
# Ne jamais commiter le fichier `.env.production` contenant les vrais secrets.

BEEP_DOMAIN=beep.click
BEEP_PUBLIC_URL=https://beep.click
# URL privée exacte du nœud Tailscale (à renseigner après création du réseau).
BO_PUBLIC_URL=
TAILSCALE_AUTHKEY_FILE=./secrets/tailscale-authkey
DOMAINS_CNAME_TARGET=beep.click
ACME_EMAIL=
BEEP_VERSION=

# Générés par make init ; conserver les secrets d’une installation existante.
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=change-me
BEEP_DB_PASSWORD=change-me
BO_DB_PASSWORD=change-me
ADMIN_API_TOKEN=change-me
ADMIN_API_TOKEN_NEXT=
TOTP_ENCRYPTION_KEY=
BO_ENCRYPTION_KEY=
# Secret indépendant de 32 octets base64 recommandé pour l’attribution.
BEEP_CONVERSION_SECRET=

# SMTP : renseigner un fournisseur autorisé à envoyer pour beep.click.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=Beep <no-reply@beep.click>
SIGNUP_MODE=invite
GEOIP_DB_PATH=
# Callback : https://beep.click/v1/auth/oauth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# Callback : https://beep.click/v1/auth/oauth/github/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

PAYMENT_PROVIDER=notchpay
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_HASH_KEY=
BILLING_VAT_RATES=CM=1925,GA=1800
BILLING_DEFAULT_COUNTRY=CM
BILLING_SELLER_NAME=Beep
BILLING_SELLER_ADDRESS=
BILLING_SELLER_TAX_ID=
URL_SAFETY_PROVIDER=web_risk
WEB_RISK_API_KEY=

LEGAL_PUBLISHER=
LEGAL_ADDRESS=
LEGAL_REGISTRATION=
LEGAL_CONTACT=
LEGAL_HOST=
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=

# Stockage WAL-G : s3://bucket/chemin et accès au dépôt de sauvegarde.
BACKUP_S3_PREFIX=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=eu-west-3
BACKUP_S3_PATH_STYLE=false
BACKUP_RETAIN_FULL=7

BEEP_DATABASE_URL=
BEEP_DATABASE_DIRECT_URL=
BEEP_READ_REPLICA_URL=
BEEP_READ_REPLICA_USER=
BEEP_READ_REPLICA_PASSWORD=
BEEP_EVENT_STORE=postgres
BEEP_REGION=local
BEEP_SSO_ALLOWED_HOSTS=
DOMAINS_ALLOWED_IPS=
DOMAINS_DNS_RESOLVER=
REDIRECT_UPSTREAMS=redirector:8080

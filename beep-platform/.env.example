# Copiez ce fichier en `.env` (make init). Ne commitez jamais `.env`.
# Générer un secret : `openssl rand -base64 32`  (ou : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")

# --- Domaine (dev : beep.localhost ; le back office est sur dashboard.<domaine>) ---
BEEP_DOMAIN=beep.localhost
BEEP_PUBLIC_URL=http://beep.localhost
BO_PUBLIC_URL=http://dashboard.beep.localhost
ACME_EMAIL=ops@beep.example
BEEP_VERSION=dev

# --- PostgreSQL ---
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=change-me
BEEP_DB_PASSWORD=change-me
BO_DB_PASSWORD=change-me
# PG_PORT=5433            # port exposé en dev (5433 évite un PostgreSQL local sur 5432)
# HTTP_PORT=80            # port HTTP exposé en dev

# --- Secrets applicatifs (OBLIGATOIRES : les services refusent de démarrer sans) ---
ADMIN_API_TOKEN=change-me            # jeton de service back office -> core (rotation trimestrielle)
# ADMIN_API_TOKEN_NEXT=              # pendant une rotation : nouveau jeton accepté en plus de l'ancien
TOTP_ENCRYPTION_KEY=                 # 32 octets base64 : chiffre les secrets TOTP des utilisateurs (core)
BO_ENCRYPTION_KEY=                   # 32 octets base64 : chiffre les secrets TOTP du staff (back office)

# --- E-mail transactionnel (dev : Mailpit, déjà configuré) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTH=false
# SMTP_STARTTLS=false
MAIL_FROM=Beep <no-reply@beep.localhost>

# --- Sauvegardes (production, WAL-G) ---
BACKUP_S3_PREFIX=s3://beep-backups/pg
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=

# Copiez ce fichier en `.env` (make init). Ne commitez jamais `.env`.
# Générer un secret : `openssl rand -base64 32`  (ou : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")

# --- Domaine (dev : beep.localhost ; le back office est sur dashboard.<domaine>) ---
BEEP_DOMAIN=beep.localhost
BEEP_PUBLIC_URL=http://beep.localhost
BO_PUBLIC_URL=http://dashboard.beep.localhost
ACME_EMAIL=ops@beep.example
BEEP_VERSION=dev

# --- PostgreSQL ---
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=change-me
BEEP_DB_PASSWORD=change-me
BO_DB_PASSWORD=change-me
# PG_PORT=5433            # port exposé en dev (5433 évite un PostgreSQL local sur 5432)
# HTTP_PORT=80            # port HTTP exposé en dev

# --- Secrets applicatifs (OBLIGATOIRES : les services refusent de démarrer sans) ---
ADMIN_API_TOKEN=change-me            # jeton de service back office -> core (rotation trimestrielle)
# ADMIN_API_TOKEN_NEXT=              # pendant une rotation : nouveau jeton accepté en plus de l'ancien
TOTP_ENCRYPTION_KEY=                 # 32 octets base64 : chiffre les secrets TOTP des utilisateurs (core)
BO_ENCRYPTION_KEY=                   # 32 octets base64 : chiffre les secrets TOTP du staff (back office)

# --- E-mail transactionnel (dev : Mailpit, déjà configuré) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTH=false
# SMTP_STARTTLS=false
MAIL_FROM=Beep <no-reply@beep.localhost>

# --- Phase 1 ---
SIGNUP_MODE=invite                   # bêta privée : comptes sur invitation (back office > Invitations) ; open = inscription libre
# GEOIP_DB_PATH=/geoip/GeoLite2-Country.mmdb   # pays des clics (licence MaxMind GeoLite2 ; monter le fichier dans le conteneur core)
# OAUTH_GOOGLE_CLIENT_ID=            # connexion Google : redirection autorisée {BEEP_PUBLIC_URL}/v1/auth/oauth/google/callback
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=            # connexion GitHub : callback {BEEP_PUBLIC_URL}/v1/auth/oauth/github/callback
# OAUTH_GITHUB_CLIENT_SECRET=

# --- Sauvegardes (production, WAL-G) ---
BACKUP_S3_PREFIX=s3://beep-backups/pg
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=

# ---------- Phase 2 : facturation ----------
# sandbox (développement, aucun appel réseau) | notchpay (Mobile Money MTN/Orange + cartes). La sandbox est refusée en production.
PAYMENT_PROVIDER=sandbox
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_HASH_KEY=
# TVA par pays en points de base (1925 = 19,25 %) : à valider avec un expert-comptable avant la production
BILLING_VAT_RATES=CM=1925,GA=1800
BILLING_DEFAULT_COUNTRY=CM
# Mentions légales imprimées sur les factures
BILLING_SELLER_NAME=Beep
BILLING_SELLER_ADDRESS=
BILLING_SELLER_TAX_ID=

# ---------- Phase 2 : sécurité des destinations ----------
# Web Risk pour un usage commercial. Safe Browsing est réservé aux usages non commerciaux.
URL_SAFETY_PROVIDER=web_risk
WEB_RISK_API_KEY=
SAFE_BROWSING_API_KEY=

# ---------- Mentions légales du site (à valider avant le lancement public) ----------
LEGAL_PUBLISHER=
LEGAL_ADDRESS=
LEGAL_REGISTRATION=
LEGAL_CONTACT=
LEGAL_HOST=

# Numéro international sans + ; aucune conversation n’est envoyée automatiquement
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=

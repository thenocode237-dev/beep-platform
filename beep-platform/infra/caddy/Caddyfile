{
	email {$ACME_EMAIL}
	on_demand_tls {
		# Seuls les domaines personnalisés vérifiés, non bloqués et au workspace actif obtiennent un certificat
		# (le core répond 200 ou 404 ; jamais exposé à l'extérieur).
		ask http://core:8080/internal/tls/allow
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# --- Site + espace client + API + redirections ---------------------------
{$BEEP_SITE} {
	encode zstd gzip
	import security_headers

	handle /internal/* {
		respond 404
	}
	handle /actuator/* {
		respond 404
	}

	# `en` et `fr` sont des slugs réservés côté core : /en/* (anglais) et /fr/* (redirigé vers l'URL sans préfixe) appartiennent au site
	@web path / /en /en/* /fr /fr/* /status* /pricing* /blog* /features* /docs* /roadmap* /changelog* /affiliates* /report* /login* /signup* /forgot-password* /reset-password* /verify-email* /app* /legal* /_next/* /assets/* /icon.svg /favicon.ico /robots.txt /sitemap.xml
	handle @web {
		reverse_proxy web:3000
	}

	handle /v1/* {
		reverse_proxy core:8080
	}

	# tout le reste : slug de lien court ou de page bio (phase 1)
	handle {
		reverse_proxy {$REDIRECT_UPSTREAMS:redirector:8080} {
			health_uri /healthz
			health_interval 10s
			health_timeout 2s
			lb_try_duration 2s
			fail_duration 30s
			max_fails 2
		}
	}
}

# --- Ancienne adresse d'administration : aucune redirection vers le VPN ---
http://dashboard.{$BEEP_SITE} {
	respond 404
}

# --- Domaines personnalisés des clients (TLS à la demande) ----------------
https:// {
	tls {
		on_demand
	}
	# S'applique aussi à un ancien certificat en cache ou à un Host forgé.
	@retired_dashboard host dashboard.{$BEEP_SITE}
	handle @retired_dashboard {
		respond 404
	}

	handle /internal/* {
		respond 404
	}
	handle {
		reverse_proxy {$REDIRECT_UPSTREAMS:redirector:8080} {
			health_uri /healthz
			health_interval 10s
			health_timeout 2s
			lb_try_duration 2s
			fail_duration 30s
			max_fails 2
		}
	}
}

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.5</version>
    <relativePath/>
  </parent>

  <groupId>io.beep</groupId>
  <artifactId>beep-core</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>beep-core</name>

  <modules>
    <module>domain</module>
    <module>application</module>
    <module>adapter-in-http</module>
    <module>adapter-in-admin</module>
    <module>adapter-out-postgres</module>
    <module>adapter-out-mail</module>
    <module>adapter-out-security</module>
    <module>adapter-out-qrrender</module>
    <module>adapter-out-geoip</module>
    <module>adapter-out-oauth</module>
    <module>bootstrap</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <archunit.version>1.3.0</archunit.version>
    <bouncycastle.version>1.79</bouncycastle.version>
  </properties>

  <!-- Tests dans tous les modules (portée test uniquement : n'altère pas les dépendances de production). -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency><groupId>io.beep</groupId><artifactId>domain</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.beep</groupId><artifactId>application</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.beep</groupId><artifactId>adapter-in-http</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.beep</groupId><artifactId>adapter-in-admin</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.beep</groupId><artifactId>adapter-out-postgres</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.beep</groupId><artifactId>adapter-out-mail</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.beep</groupId><artifactId>adapter-out-security</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.beep</groupId><artifactId>adapter-out-qrrender</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.beep</groupId><artifactId>adapter-out-geoip</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>io.beep</groupId><artifactId>adapter-out-oauth</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.google.zxing</groupId><artifactId>core</artifactId><version>3.5.3</version></dependency>
      <dependency><groupId>com.maxmind.geoip2</groupId><artifactId>geoip2</artifactId><version>4.2.1</version></dependency>
      <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><version>${archunit.version}</version></dependency>
      <dependency><groupId>org.bouncycastle</groupId><artifactId>bcprov-jdk18on</artifactId><version>${bouncycastle.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

  <profiles>
    <!-- Tests d'intégration (*IT) : PostgreSQL réel via Testcontainers ou TEST_DATABASE_URL. `make test-int`. -->
    <profile>
      <id>integration</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <goals><goal>integration-test</goal><goal>verify</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration><release>21</release><parameters>true</parameters></configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
